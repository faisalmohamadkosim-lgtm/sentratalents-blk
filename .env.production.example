# Template produksi (blk.sentratalents.com). Salin ke .env di server; isi APP_KEY dan password. JANGAN commit .env.
APP_NAME="BLK Connect"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://blk.sentratalents.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=blk
DB_USERNAME=blk
DB_PASSWORD=GANTI_PASSWORD_APP
DB_ROOT_PASSWORD=GANTI_PASSWORD_ROOT

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# URL LAN untuk QR absensi/kios di jaringan lokal (kosong di produksi: pakai APP_URL https).
PATIENT_QR_LAN_URL=
